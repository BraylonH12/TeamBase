{
  "name": "teambase",
  "version": "1.0.0",
  "description": "Centralized sports organization and athletic management web application",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov --exclude tests/** node --test",
    "db:reset": "node server/scripts/reset-db.js",
    "db:migrate": "node server/scripts/migrate.js"
  },
  "keywords": [
    "sports",
    "team-management",
    "express",
    "postgresql"
  ],
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.17.0"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
